#!/bin/sh
# Runs every experiment; each checks itself against its reference and exits 1 on a mismatch.
cd "$(dirname "$0")/.." || exit 1
status=0
for f in experiments/*.sc; do
  printf '%-28s ' "$f"
  if out=$(scala-cli run "$f" 2>&1); then echo "$out" | tail -1; else echo "FAILED"; echo "$out" | grep -v WARNING | tail -5; status=1; fi
done
exit $status
